#!jinja2
# Cylc Suit for running SKRIPPS AP8km4km 20 year ERA-GLORIS
# Author: Prajeesh
#
# NOTE:
#   MAINCYCLE can't be less than P1D

{% set MAINCYCLE="P30D" %}
{% set POSTCYCLE="P1M" %}
{% set wpsInputSec=21600 %}
{% set atmOutFreqMins=180 %}
{% set atmFileFreqMins=1440 %}
{% set ocnOutFreqSecs=21600 %}
{% set atmDT=20 %}
{% set ocnDT=60 %}
{% set cplDT=60 %}

{% set VARLIST2D = "MU,MUB,Q2,T2,TH2,PSFC,U10,V10,SNOALB,SEAICE,XICEM,SFROFF,UDROFF,IVGTYP,ISLTYP,VEGFRA,GRDFLX,ACGRDFLX,ACSNOM,SNOW,SNOWH,CANWAT,SSTSK,LAI,NUPDRAFT,MAXMF,MF_VX_INV,HGT,TSK,RAINC,RAINSH,RAINNC,SNOWNC,GRAUPELNC,HAILNC,SWDOWN,GLW,SWNORM,ACSWUPT,ACSWUPTC,ACSWDNT,ACSWDNTC,ACSWUPB,ACSWUPBC,ACSWDNB,ACSWDNBC,ACLWUPT,ACLWUPTC,ACLWDNT,ACLWDNTC,ACLWUPB,ACLWUPBC,ACLWDNB,ACLWDNBC,SWUPT,SWUPTC,SWDNT,SWDNTC,SWUPB,SWUPBC,SWDNB,SWDNBC,LWUPT,LWUPTC,LWDNT,LWDNTC,LWUPB,LWUPBC,LWDNB,LWDNBC,OLR,ALBEDO,ALBBCK,EMISS,NOAHRES,TMN,UST,PBLH,HFX,QFX,LH,ACHFX,ACLHF,SNOWC,SR,PCB,PC,SST,SST_INPUT,ZS,DZS,TSLB,SMOIS,SH2O,SMCREL" %}

{% set WPS_DIR = SKRIPS_DIR ~ "/external/WPS" %}
{% set UPP_DIR = SKRIPS_DIR ~ "/external/UPPV4.0.1" %}

{% set SKRIPS_EXE = SKRIPS_DIR ~ "/build/AP4km/238/main/skrips.exe" %}
{% set REAL_EXE = SKRIPS_DIR ~ "/external/WRF/main/real.exe" %}
{% set WRF_RUN_DIR = SKRIPS_DIR ~ "/external/WRF/test/em_real" %}

{% set LINK_GRIB = WPS_DIR ~ "/link_grib.csh" %}
{% set UNGRIB_DIR = WPS_DIR ~ "/ungrib" %}
{% set METGRID_DIR = WPS_DIR ~ "/metgrid" %}
{% set ENV_FILE = SKRIPS_DIR ~ "/env.mach" %}


##
{% set cpuTotal=cpuOCN+cpuATM %}
{% set nTimesInWRFout=atmFileFreqMins/atmOutFreqMins %}

[scheduling]
    initial cycle point = 2000-01-01
    final cycle point = 2021-01-01
    runahead limit = P20
    [[xtriggers]]
        wait = echo('Waiting for trigger')
    [[graph]]
        {{ MAINCYCLE }} = """
            skrips[-{{ MAINCYCLE }}]:submitted => wps_real
            wps_real & move_restarts[-{{ MAINCYCLE }}] => link_restarts
            link_restarts => skrips
            skrips => move_restarts => move_outputs
            move_outputs => trigger_post_proc 
            trigger_post_proc => scrap_rundir
        """
        {{ POSTCYCLE }} = """
            @wait => post_proc
            post_proc & ar_mitgcm_out[-{{ POSTCYCLE }}] => mitgcm2nc => ar_mitgcm_out
            post_proc & ar_wrf_out[-{{ POSTCYCLE }}] => upp
            post_proc & ar_wrf_out[-{{ POSTCYCLE }}] => splitVar
            upp & splitVar => ar_wrf_out
        """

[runtime]
    [[root]]
      work sub-directory = $CYLC_TASK_CYCLE_POINT/
      [[[environment]]]

        dx=4000
        dy=4000
        e_we=801
        e_sn=781

        # WRF Physics options
        #cu_physics=1
        #cu_physics=4, !Scale aware SAS scheme 
        cu_physics=0, !No convection scheme 

        # Run 1 hour extra because WRF sometimes fails to write restart files
        history_interval={{ atmOutFreqMins }}
        dumpFreq={{ ocnOutFreqSecs }}
        time_step={{ atmDT }}
        deltaT={{ ocnDT }}
        CPL_TIME_STEP={{ cplDT }}
            
        etcdir=$CYLC_WORKFLOW_RUN_DIR/etc

        NEXT_CYCLE_POINT=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} --offset1={{ MAINCYCLE }})

        NEXT_CYCLE_POINT_POST=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} --offset1={{ POSTCYCLE }})

        RUN_DURATION_HOURS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total H)
        RUN_DURATION_MINS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total M)
        RUN_DURATION_SECS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total S)

        RUN_DURATION_HOURS_FINAL=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${CYLC_WORKFLOW_FINAL_CYCLE_POINT} --as-total H)
        start_year=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f CCYY)
        start_month=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f MM)
        start_day=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f DD)
        start_hour=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f Thh | sed 's/T//g')

        end_year=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f CCYY)
        end_month=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f MM)
        end_day=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f DD)
        end_hour=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f Thh | sed 's/T//g')

        startTime=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} ${CYLC_TASK_CYCLE_POINT} --as-total S)
        startTimeNext=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total S)

        startDate=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} -f CCYYMMDD)
        ref_date=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} -f CCYY-MM-DD)
        endTime=$startTimeNext

        restart=".true."
        restart_interval=$RUN_DURATION_MINS

        OUTPUT_DIR={{ POST_PATH }}/$CYLC_WORKFLOW_NAME
        RESTART_DIR={{ ARCHIVE_PATH }}/RESTART/$CYLC_WORKFLOW_NAME
        ARCHIVE_DIR={{ ARCHIVE_PATH }}/OUTPUT/$CYLC_WORKFLOW_NAME

        interval_seconds={{ wpsInputSec }}
        chkptFreq=$RUN_DURATION_SECS
        
        cpuOCN={{ cpuOCN }}
        cpuATM={{ cpuATM }}

        [[[directives]]]
          {% if SITE != "ncm" %}
          --account = {{ ACCOUNT }}
          {% endif %}

    [[wps_real]]
        script = """

            envsubst < $etcdir/namelist.wps > namelist.wps
            envsubst < $etcdir/namelist.input_40levs > namelist.input
            ln -sf {{ UNGRIB_DIR }} .
            cp -f $etcdir/Vtable .
            ln -sf {{ METGRID_DIR }} .
            ln -sf {{ GEO_EM_FILE }} geo_em.d01.nc

            if [[ $start_year != $end_year ]] || [[ $start_month != $end_month ]]; then 
                {{ LINK_GRIB }} {{ ERA_DATA }}/${start_year}/${start_year}_${start_month}*.grib \
                                {{ ERA_DATA }}/${end_year}/${end_year}_${end_month}*.grib
            else
                {{ LINK_GRIB }} {{ ERA_DATA }}/${start_year}/${start_year}_${start_month}*.grib
            fi

            source {{ ENV_FILE }}

            ./ungrib/ungrib.exe 
            
            srun -n 1 ./metgrid/metgrid.exe 

            srun -n {{ cpuPerNode }} {{ REAL_EXE }} 
        """
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = 1
            --ntasks = {{ cpuPerNode }}
            --time=12:00:00

    [[move_restarts]]
        script = """
            set -x
            echo "Move restart files"
            mkdir -p $RESTART_DIR
            find . -type l -delete # Delete all softlinks
            nIter=$(echo "$startTimeNext/$deltaT" | bc)
            nIter=$(printf "%010d\n" $nIter)
            
            rsync -a  ./wrfrst_* $RESTART_DIR/
            rsync -a ./pickup.$nIter.data ./pickup.$nIter.meta $RESTART_DIR/
            rm ./wrfrst_*
            rm ./pickup.$nIter.*
        """

    [[link_restarts]]
        script = """
            echo "Link restart files"
            # Link restart files
            [[ "$CYLC_TASK_CYCLE_POINT" == "$CYLC_WORKFLOW_INITIAL_CYCLE_POINT" ]] && \
            echo "Cold start: No restart to link" && exit 0

            nIter=$(echo "$startTime/$deltaT" | bc)
            nIter=$(printf "%010d\n" $nIter)
            dateStamp=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} --format CCYY-MM-DDThh:mm:ss | sed 's/T/_/g')

            source_file=$RESTART_DIR/pickup.$nIter.meta
            [ -e "$source_file" ] && ln -sf "$source_file" . || { echo "Error while linking $source_file "; exit 1;}

            source_file=$RESTART_DIR/pickup.$nIter.data
            [ -e "$source_file" ] && ln -sf "$source_file" . || { echo "Error while linking $source_file "; exit 1;}

            source_file=$RESTART_DIR/wrfrst_d01_$dateStamp
            [ -e "$source_file" ] && ln -sf "$source_file" . || { echo "Error while linking $source_file "; exit 1;}
        """

    [[move_outputs]]
        script = """
            echo "Move Outputs"
            mkdir -p $OUTPUT_DIR/ATM
            mv wrfout_* $OUTPUT_DIR/ATM/

            mkdir -p $OUTPUT_DIR/OCN
            mv *.data *.meta  $OUTPUT_DIR/OCN/
            if [ -f available_diagnostics.log ]; then
                mkdir -p $ARCHIVE_DIR/OCN
                cp available_diagnostics.log $ARCHIVE_DIR/OCN
            fi
        """

    [[post_proc]]
        script = """
            echo "Starting post processing for month $start_month/$start_year"
        """

    [[mitgcm2nc]]
        script = """
          cd $OUTPUT_DIR/OCN
          ln -sf $ARCHIVE_DIR/OCN/available_diagnostics.log .
          {{ PYTHON }} $etcdir/mitgcm2nc.py $ref_date {{ ocnDT }} $start_year $start_month \
          $OUTPUT_DIR/OCN $OUTPUT_DIR/OCN --delete
        """
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = 1
            --ntasks=1
            --time=12:00:00

     [[ar_mitgcm_out]]
         script = """
           cd $OUTPUT_DIR/OCN
           mkdir -p $ARCHIVE_DIR/OCN
           rsync -av --remove-source-files *.nc $ARCHIVE_DIR/OCN
         """
         platform={{ DATAMOVER }}

    [[splitVar]]
      script = """
       modelDataPath=$OUTPUT_DIR/ATM
       YY=$start_year 
       MM=$start_month
       mkdir -p $OUTPUT_DIR/ATM/$YY/$MM
       cd $OUTPUT_DIR/ATM/$YY/$MM
       {{ CDO }} -splitvar -mergetime [ -apply,-selvar,{{ VARLIST2D }} [ $modelDataPath/wrfout_d01_${YY}-${MM}-* ] ] WRF_
       """
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = 1
            --ntasks=1
            --time=12:00:00

     [[ar_wrf_out]]
         script = """
           YY=$start_year 
           MM=$start_month
           cd $OUTPUT_DIR/ATM/$YY/$MM
           mkdir -p $ARCHIVE_DIR/ATM/$YY/$MM
           rsync -av --remove-source-files *.nc $ARCHIVE_DIR/ATM/$YY/$MM
           rsync -av --remove-source-files *.grb $ARCHIVE_DIR/ATM/$YY/$MM
           rm $OUTPUT_DIR/ATM/wrfout_d01_${YY}-${MM}-*
         """
         platform={{ DATAMOVER }}
    

    [[scrap_rundir]]
        script = """
            echo "Scrap run directory"
            rm -rf *
        """


    [[skrips]]
        script = """
            
            [[ "$CYLC_TASK_CYCLE_POINT" == "$CYLC_WORKFLOW_INITIAL_CYCLE_POINT" ]] &&  export restart=".false."

            ln -sf {{ BATHY_FILE }} .
            ln -sf {{ MITGRID_FILE }} . 
            cp -f {{ WRF_RUN_DIR }}/* .
            cp -f $etcdir/* .
            envsubst < $etcdir/namelist.esmf > namelist.esmf
            envsubst < $etcdir/namelist.wps > namelist.wps
            envsubst < $etcdir/namelist.input_40levs > namelist.input
            envsubst < $etcdir/data > data
            envsubst < $etcdir/data.cal > data.cal
            envsubst < $etcdir/data.diagnostics > data.diagnostics
            envsubst < $etcdir/namelist.rc > namelist.rc

            # Link Ocean BND and INI files
            ln -sf {{ GLORYS_DATA }}/* .
            source {{ ENV_FILE }}
            export FI_CXI_RX_MATCH_MODE=hybrid
            srun -n {{ cpuTotal }} --hint=nomultithread {{ SKRIPS_EXE }}
        """
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = {{ nNodes }}
            --ntasks = {{ cpuTotal }}
            --time=24:00:00

    [[upp]]
      script = """
       modelDataPath=$OUTPUT_DIR/ATM
       mkdir -p $OUTPUT_DIR/ATM/$start_year/$start_month
       cd $OUTPUT_DIR/ATM/$start_year/$start_month

       ln -fs ${txtCntrlFile} postxconfig-NT.txt
       ln -fs {{ UPP_DIR }}/parm/post_avblflds.xml post_avblflds.xml
       ln -fs {{ UPP_DIR }}/src/lib/g2tmpl/params_grib2_tbl_new params_grib2_tbl_new
       ln -fs {{ UPP_DIR }}/parm/nam_micro_lookup.dat .
       ln -fs {{ UPP_DIR }}/parm/hires_micro_lookup.dat .

       ln -fs $CRTMDIR/EmisCoeff/IR_Water/Big_Endian/* .

       ln -fs $CRTMDIR/EmisCoeff/IR_Land/SEcategory/Big_Endian/* .

       ln -fs $CRTMDIR/AerosolCoeff/Big_Endian/AerosolCoeff.bin     ./
       ln -fs $CRTMDIR/CloudCoeff/Big_Endian/CloudCoeff.bin         ./

       ln -fs $CRTMDIR/SpcCoeff/Big_Endian/* .
       ln -fs $CRTMDIR/TauCoeff/ODPS/Big_Endian/* .

       source {{ ENV_FILE }}
       
       current_date=${CYLC_TASK_CYCLE_POINT}
       while [[ $current_date < $NEXT_CYCLE_POINT_POST ]]; do
            export dStamp=$({{ ISODATETIME }} ${current_date} --format CCYY-MM-DDThh:mm:ss | sed 's/T/_/g')
            export inFile=$modelDataPath/wrfout_d01_$dStamp
            # Check if that file exists
            if [[ ! -e ${inFile} ]]; then
              echo "ERROR: Can't find ${inFile}. Directory or file does not exist.  Exiting..."
              echo "ERROR: Check if 'modelDataPath': ${modelDataPath} exists."
              exit 1
            fi
            
            idate=$current_date
            for i in $(seq 1 {{ nTimesInWRFout }}); do 
              export dateStamp=$({{ ISODATETIME }} ${idate} --format CCYY-MM-DDThh:mm:ss | sed 's/T/_/g')
              oFile=wrfprs_d01_${dateStamp}.grb2

              envsubst < $etcdir/itag > itag
              srun -n {{ uppNtasks }} {{ UPP_DIR }}/bin/unipost.exe 
              mv WRFPRS* $oFile
              idate=$({{ ISODATETIME }} ${idate} --offset1=PT{{ atmOutFreqMins }}M)
            done
            current_date=$({{ ISODATETIME }} ${current_date} --offset1=PT{{ atmFileFreqMins }}M)
       done
       grib_copy wrfprs_d01_*.grb2 'WRFPRS_[shortName].grb'
       rm -f wrfprs_d01_*.grb2
      """
      platform={{ PLATFORM }}
      [[[environment]]]
        txtCntrlFile=$CYLC_WORKFLOW_RUN_DIR/etc/postxconfig-NT-WRFPRS.txt # grib2
        tmmark=tm00
        #MP_SHARED_MEMORY=no
        #MP_LABELIO=yes
        CRTMDIR={{ UPP_DIR }}/src/lib/crtm2/src/fix

      [[[directives]]]
         --nodes = 1
         --ntasks = {{ cpuPerNode }}

  [[trigger_post_proc]]
    script = """
      endDate=$NEXT_CYCLE_POINT
      [[ $endDate > ${CYLC_WORKFLOW_FINAL_CYCLE_POINT} ]] && endDate=${CYLC_WORKFLOW_FINAL_CYCLE_POINT}
      currentDate=${CYLC_TASK_CYCLE_POINT}
      endDate=${endDate:0:6}01T0000
      while [[ "$currentDate" < "$endDate" ]]; do
        bdate=${currentDate:0:6}01T0000
        echo "b_date: $bdate"
        echo cylc trigger $CYLC_WORKFLOW_NAME//${bdate}/post_proc
        cylc trigger $CYLC_WORKFLOW_NAME//${bdate}/post_proc
        currentDate=$(isodatetime "$currentDate" --offset1={{ POSTCYCLE }})
      done
    """
