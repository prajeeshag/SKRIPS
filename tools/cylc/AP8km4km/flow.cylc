#!jinja2
# Cylc Suit for running SKRIPS AP8km4km 20 year run using ERA5-GLORYS data
# Author: Prajeesh
#
# NOTE:
#   MAINCYCLE can't be less than P1D

{% set MAINCYCLE="P3D" %}
{% set POSTCYCLE="P1M" %}
{% set wpsInputSec=21600 %}

{% set wrf2dFreq=3600 %}
{% set wrf3dFreq=21600 %}
{% set ocn2dFreq=86400 %}
{% set ocn3dFreq=432000 %}
{% set atmDT=45 %}
{% set ocnDT=90 %}
{% set cplDT=90 %}

{% set WPS_DIR = SKRIPS_DIR ~ "/external/WPS" %}
{% set UPP_DIR = SKRIPS_DIR ~ "/external/UPPV4.0.1" %}

{% set SKRIPS_EXE = SKRIPS_DIR ~ "/build/AP4km/238/main/skrips.exe" %}
{% set REAL_EXE = SKRIPS_DIR ~ "/external/WRF/main/real.exe" %}
{% set WRF_RUN_DIR = SKRIPS_DIR ~ "/external/WRF/test/em_real" %}

{% set ENV_FILE = SKRIPS_DIR ~ "/env.mach" %}


##
{% set cpuTotal=cpuOCN+cpuATM %}
{% set nTimesInWRFout=1 %}

[scheduling]
    initial cycle point = 2000-01-01
    final cycle point = 2000-02-01
    runahead limit = P20
    [[xtriggers]]
        wait = echo('Waiting for trigger')
    [[graph]]
        {{ MAINCYCLE }} = """
            skrips[-{{ MAINCYCLE }}]:submitted => ungrib => metgrid => real 
            real & move_restarts[-{{ MAINCYCLE }}] => link_restarts
            link_restarts => skrips
            skrips => upp & move_restarts
            upp => move_outputs
            move_outputs => trigger_post_proc 
            trigger_post_proc => scrap_rundir
        """
        #{{ POSTCYCLE }} = """
        #    @wait => post_proc
        #    post_proc & ar_mitgcm_out[-{{ POSTCYCLE }}] => mitgcm2nc => ar_mitgcm_out
        #    post_proc & ar_wrf_out[-{{ POSTCYCLE }}] => upp
        #    post_proc & ar_wrf_out[-{{ POSTCYCLE }}] => splitVar
        #    upp & splitVar => ar_wrf_out
        #"""

[runtime]
    [[root]]
      pre-script = "source {{ ENV_FILE }}"
      #work sub-directory = $CYLC_TASK_CYCLE_POINT
      execution retry delays = PT2M # Default retry once after 2 minutes

      [[[environment]]]

        # Run 1 hour extra because WRF sometimes fails to write restart files
        history_interval=1000000000
        time_step={{ atmDT }}
        deltaT={{ ocnDT }}
        CPL_TIME_STEP={{ cplDT }}
        nproc_x={{ nproc_x|default(-1) }}
        nproc_y={{ nproc_y|default(-1) }}
        wrf2dFreq={{ wrf2dFreq }}
        wrf3dFreq={{ wrf3dFreq }}
        ocn2dFreq={{ ocn2dFreq }}
        ocn3dFreq={{ ocn3dFreq }}
        nio_tasks_per_group={{ nio_tasks_per_group }}
        nio_groups={{ nio_groups }}

            
        etcdir=$CYLC_WORKFLOW_RUN_DIR/etc
        WPS_DIR={{ WPS_DIR }}
        GEO_EM_FILE={{ GEO_EM_FILE }}
        ERA5_DATA={{ ERA5_DATA }}
        SKRIPS_EXE={{ SKRIPS_EXE }}
        SKRIPS_DIR={{ SKRIPS_DIR }}
        REAL_EXE={{ REAL_EXE }}
        cpuPerNode={{ cpuPerNode }}

        NEXT_CYCLE_POINT=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} --offset1={{ MAINCYCLE }})

        NEXT_CYCLE_POINT_POST=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} --offset1={{ POSTCYCLE }})

        RUN_DURATION_HOURS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total H)
        RUN_DURATION_MINS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total M)
        RUN_DURATION_SECS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total S)

        RUN_DURATION_HOURS_FINAL=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${CYLC_WORKFLOW_FINAL_CYCLE_POINT} --as-total H)
        start_year=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f CCYY)
        start_month=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f MM)
        start_day=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f DD)
        start_hour=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f Thh | sed 's/T//g')

        end_year=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f CCYY)
        end_month=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f MM)
        end_day=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f DD)
        end_hour=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f Thh | sed 's/T//g')

        startTime=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} ${CYLC_TASK_CYCLE_POINT} --as-total S)
        startTimeNext=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total S)

        startDate=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} -f CCYYMMDD)
        ref_date=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} -f CCYY-MM-DD)
        endTime=$startTimeNext

        restart=".true."
        restart_interval=$RUN_DURATION_MINS

        OUTPUT_DIR={{ POST_PATH }}/$CYLC_WORKFLOW_NAME
        RESTART_DIR={{ ARCHIVE_PATH }}/RESTART/$CYLC_WORKFLOW_NAME
        ARCHIVE_DIR={{ ARCHIVE_PATH }}/OUTPUT/$CYLC_WORKFLOW_NAME

        interval_seconds={{ wpsInputSec }}
        interval_minutes={{ wpsInputSec / 60 }}
        chkptFreq=$RUN_DURATION_SECS
        
        cpuOCN={{ cpuOCN }}
        cpuATM={{ cpuATM }}

        [[[directives]]]
          {% if SITE != "ncm" %}
          --account = {{ ACCOUNT }}
          {% endif %}

    [[ungrib]]
        script = "ungrib.sh"
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = 1
            --ntasks = 1
            --partition=shared

    [[metgrid]]
        script = "metgrid.sh"
            
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = 1
            --ntasks = 1
            --partition=shared

    [[real]]
        script = "real.sh"
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = 1
            --ntasks = {{ cpuPerNode }}

    [[move_restarts]]
        script = "move_restarts.sh"

    [[link_restarts]]
        script = "link_restarts.sh"

    [[mv_ocn_out]]
        script = "mv_ocn_out.sh"

    [[post_proc]]
        script = """
            echo "Starting post processing for month $start_month/$start_year"
        """

    [[mitgcm2nc]]
        script = """
          cd $OUTPUT_DIR/OCN
          ln -sf $ARCHIVE_DIR/OCN/available_diagnostics.log .
          {{ PYTHON }} $etcdir/mitgcm2nc.py $ref_date {{ ocnDT }} $start_year $start_month \
          $OUTPUT_DIR/OCN $OUTPUT_DIR/OCN --delete
        """
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = 1
            --ntasks=1
            --time=12:00:00

     [[ar_mitgcm_out]]
         script = """
           cd $OUTPUT_DIR/OCN
           mkdir -p $ARCHIVE_DIR/OCN
           rsync -av --remove-source-files *.nc $ARCHIVE_DIR/OCN
         """
         platform={{ DATAMOVER }}

     [[ar_wrf_out]]
         script = """
           YY=$start_year 
           MM=$start_month
           cd $OUTPUT_DIR/ATM/$YY/$MM
           mkdir -p $ARCHIVE_DIR/ATM/$YY/$MM
           rsync -av --remove-source-files *.nc $ARCHIVE_DIR/ATM/$YY/$MM
           rsync -av --remove-source-files *.grb $ARCHIVE_DIR/ATM/$YY/$MM
           rm $OUTPUT_DIR/ATM/wrfout_d01_${YY}-${MM}-*
         """
         platform={{ DATAMOVER }}
    

    [[scrap_rundir]]
        script = """
            echo "Scrap run directory"
            rm -rf *
        """


    [[skrips]]
        script = """
            
            [[ "$CYLC_TASK_CYCLE_POINT" == "$CYLC_WORKFLOW_INITIAL_CYCLE_POINT" ]] &&  export restart=".false."

            ln -sf {{ BATHY_FILE }} .
            ln -sf {{ MITGRID_FILE }} . 
            cp -f {{ WRF_RUN_DIR }}/* .

            for i in $etcdir/wrf/*; do 
                basei=$( basename $i )
                envsubst < $i > $basei
            done
            for i in $etcdir/mitgcm/*; do 
                basei=$( basename $i )
                envsubst < $i > $basei
            done
            for i in $etcdir/cpld/*; do 
                basei=$( basename $i )
                envsubst < $i > $basei
            done

            # Link Ocean BND and INI files
            ln -sf {{ GLORYS_DATA }}/* .
            source {{ ENV_FILE }}
            export FI_CXI_RX_MATCH_MODE=hybrid
            srun -n {{ cpuTotal }} --distribution=block:block --hint=nomultithread {{ SKRIPS_EXE }}
        """
        platform={{ PLATFORM }}
        [[[directives]]]
            --nodes = {{ nNodes }}
            --ntasks = {{ cpuTotal }}
            --time=24:00:00

    [[upp]]
      pre-script = "source {{ ENV_FILE }}"
      script = """
        upp.sh -u {{ UPP_DIR }} -c $etcdir/postxconfig-NT2d.txt -p wrf2d_ -r "srun -n 32"
        upp.sh -u {{ UPP_DIR }} -c $etcdir/postxconfig-NT3d.txt -p wrf3d_ -r "srun -n 32"
        """
      platform={{ PLATFORM }}
      [[[environment]]]
        tmmark=tm00

      [[[directives]]]
         --nodes = 1
         --ntasks = {{ cpuPerNode }}

  [[trigger_post_proc]]
    script = """
      endDate=$NEXT_CYCLE_POINT
      [[ $endDate > ${CYLC_WORKFLOW_FINAL_CYCLE_POINT} ]] && endDate=${CYLC_WORKFLOW_FINAL_CYCLE_POINT}
      currentDate=${CYLC_TASK_CYCLE_POINT}
      endDate=${endDate:0:6}01T0000
      while [[ "$currentDate" < "$endDate" ]]; do
        bdate=${currentDate:0:6}01T0000
        echo "b_date: $bdate"
        echo cylc trigger $CYLC_WORKFLOW_NAME//${bdate}/post_proc
        cylc trigger $CYLC_WORKFLOW_NAME//${bdate}/post_proc
        currentDate=$(isodatetime "$currentDate" --offset1={{ POSTCYCLE }})
      done
    """
