#!jinja2
# Cylc Suit for running SKRIPPS AP8km4km 20 year ERA-GLORIS
# Author: Prajeesh
#
# NOTE:
#   MAINCYCLE can't be less than P1D

{% set MAINCYCLE="P30D" %}
{% set POSTCYCLE="P1M" %}
{% set cpuOCN=238 %}
{% set cpuATM=1024 %}
{% set nUPPjobs=4 %}
{% set nNodes=20 %}
{% set wpsInputSec=21600 %}
{% set cpuPerNode=64 %}
{% set atmOutFreqMins=180 %} # WRF output 3 hourly
{% set ocnOutFreqSecs=21600 %} # 6 hourly
{% set atmDT=45 %}
{% set ocnDT=60 %}
{% set cplDT=180 %}


{% set SKRIPS_DIR = "/g/home/pgopinathan/SKRIPS" %}
{% set PYTHON="/g/home/pgopinathan/miniforge3/bin/python" %}
{% set PARALLEL="/g/home/pgopinathan/miniforge3/bin/parallel" %}
{% set ISODATETIME="/g/home/pgopinathan/bin/isodatetime" %}
{% set POST_PATH="/g/home/pgopinathan/POST_PATH" %}
{% set ARCHIVE_PATH="/g260/ccc/pgopinathan/ARCHIVE" %}
{% set ERA_DATA="/g260/ccc/data-from-kaust/ERA5_grib2/ERA5" %}
{% set GLORYS_DATA="/g260/ccc/data-from-kaust/SKRIPS_DATA/AP8km4km/GLORYS_bnd" %}
{% set WPS_DIR = SKRIPS_DIR ~ "/external/WPS" %}
#{% set UPP_DIR = SKRIPS_DIR ~ "/external/UPPV4.0.1" %}
{% set UPP_DIR = "/g/apps/local/components/upp/4.0.1/el8_intel2021.2" %}

{% set GEO_EM_FILE = "/g/home/pgopinathan/SKRIP_Grids/AP/4km/8km/geo_em.d01_mod.nc" %}
{% set BATHY_FILE = "/g/home/pgopinathan/SKRIP_Grids/AP/4km/bathymetry.bin" %}
{% set MITGRID_FILE = "/g/home/pgopinathan/SKRIP_Grids/AP/4km/tile001.mitgrid" %}

{% set SKRIPS_EXE = SKRIPS_DIR ~ "/build/AP4km/238/main/skrips.exe" %}
{% set REAL_EXE = SKRIPS_DIR ~ "/external/WRF/main/real.exe" %}
{% set WRF_RUN_DIR = SKRIPS_DIR ~ "/external/WRF/test/em_real" %}

{% set LINK_GRIB = WPS_DIR ~ "/link_grib.csh" %}
{% set UNGRIB_DIR = WPS_DIR ~ "/ungrib" %}
{% set METGRID_DIR = WPS_DIR ~ "/metgrid" %}
{% set ENV_FILE = SKRIPS_DIR ~ "/env.mach" %}


##
{% set cpuTotal=cpuOCN+cpuATM %}

[scheduling]
    initial cycle point = 2000-01-01
    final cycle point = 2021-01-01
    [[xtriggers]]
        wait = echo('Waiting for trigger')
    [[graph]]
        {{ MAINCYCLE }} = """
            skrips[-{{ MAINCYCLE }}]:submitted => wps_real
            wps_real & move_restarts[-{{ MAINCYCLE }}] => link_restarts
            link_restarts => skrips
            skrips => move_restarts
            skrips => upp => move_outputs
            move_outputs & move_restarts => scrap_rundir
        """
#        {{ POSTCYCLE }} = """
#            @wait => post_proc
#        """

[runtime]
    [[root]]
      work sub-directory = $CYLC_TASK_CYCLE_POINT/
      [[[environment]]]

        # Run 1 hour extra because WRF sometimes fails to write restart files
        history_interval={{ atmOutFreqMins }}
        dumpFreq={{ ocnOutFreqSecs }}
        time_step={{ atmDT }}
        deltaT={{ ocnDT }}
        CPL_TIME_STEP={{ cplDT }}
            
        etcdir=$CYLC_WORKFLOW_RUN_DIR/etc

        NEXT_CYCLE_POINT=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} --offset1={{ MAINCYCLE }})
        RUN_DURATION_HOURS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total H)
        RUN_DURATION_MINS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total M)
        RUN_DURATION_SECS=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total S)

        RUN_DURATION_HOURS_FINAL=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} ${CYLC_WORKFLOW_FINAL_CYCLE_POINT} --as-total H)
        start_year=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f CCYY)
        start_month=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f MM)
        start_day=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f DD)
        start_hour=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} -f Thh | sed 's/T//g')

        end_year=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f CCYY)
        end_month=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f MM)
        end_day=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f DD)
        end_hour=$({{ ISODATETIME }} ${NEXT_CYCLE_POINT} -f Thh | sed 's/T//g')

        startTime=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} ${CYLC_TASK_CYCLE_POINT} --as-total S)
        startTimeNext=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} ${NEXT_CYCLE_POINT} --as-total S)

        startDate=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} -f CCYYMMDD)
        ref_date=$({{ ISODATETIME }} ${CYLC_WORKFLOW_INITIAL_CYCLE_POINT} -f CCYY-MM-DD)
        endTime=$startTimeNext

        restart=".true."
        restart_interval=$RUN_DURATION_MINS

        OUTPUT_DIR={{ POST_PATH }}/$CYLC_WORKFLOW_NAME
        RESTART_DIR={{ ARCHIVE_PATH }}/RESTART/$CYLC_WORKFLOW_NAME

        # WRF Physics options
        cu_physics=1, !Kain-Fritsch (new Eta) scheme 
        #cu_physics=4, !Scale aware SAS scheme 
        #cu_physics=0, !No convection scheme 
        interval_seconds={{ wpsInputSec }}
        chkptFreq=$RUN_DURATION_SECS
        
        cpuOCN={{ cpuOCN }}
        cpuATM={{ cpuATM }}

    [[wps_real]]
        script = """

            envsubst < $etcdir/namelist.wps > namelist.wps
            envsubst < $etcdir/namelist.input_40levs > namelist.input
            ln -sf {{ UNGRIB_DIR }} .
            cp -f $etcdir/Vtable .
            ln -sf {{ METGRID_DIR }} .
            ln -sf {{ GEO_EM_FILE }} geo_em.d01.nc

            if [[ $start_year != $end_year ]] || [[ $start_month != $end_month ]]; then 
                {{ LINK_GRIB }} {{ ERA_DATA }}/$start_year/${start_year}_${start_month}*.grib \
                                {{ ERA_DATA }}/$end_year/${end_year}_${end_month}*.grib
            else
                {{ LINK_GRIB }} {{ ERA_DATA }}/$start_year/${start_year}_${start_month}*.grib
            fi

            source {{ ENV_FILE }}

            ./ungrib/ungrib.exe 
            
            srun -n 1 ./metgrid/metgrid.exe 

            srun -n {{ cpuPerNode }} {{ REAL_EXE }} 
        """
        platform = cluster
        [[[directives]]]
            --nodes = 1
            --ntasks = {{ cpuPerNode }}
            --time=12:00:00

    [[move_restarts]]
        script = """
            set -x
            echo "Move restart files"
            mkdir -p $RESTART_DIR
            find . -type l -delete # Delete all softlinks
            nIter=$(echo "$startTimeNext/$deltaT" | bc)
            nIter=$(printf "%010d\n" $nIter)
            
            rsync -a  ./wrfrst_* $RESTART_DIR/
            rsync -a ./pickup.$nIter.* $RESTART_DIR/
        """

    [[link_restarts]]
        script = """
            echo "Link restart files"
            # Link restart files
            [[ "$CYLC_TASK_CYCLE_POINT" == "$CYLC_WORKFLOW_INITIAL_CYCLE_POINT" ]] && \
            echo "Cold start: No restart to link" && exit 0

            nIter=$(echo "$startTime/$deltaT" | bc)
            nIter=$(printf "%010d\n" $nIter)
            dateStamp=$({{ ISODATETIME }} ${CYLC_TASK_CYCLE_POINT} --format CCYY-MM-DDThh:mm:ss | sed 's/T/_/g')

            source_file=$RESTART_DIR/pickup.$nIter.meta
            [ -e "$source_file" ] && ln -sf "$source_file" . || { echo "Error while linking $source_file "; exit 1;}

            source_file=$RESTART_DIR/pickup.$nIter.data
            [ -e "$source_file" ] && ln -sf "$source_file" . || { echo "Error while linking $source_file "; exit 1;}

            source_file=$RESTART_DIR/wrfrst_d01_$dateStamp
            [ -e "$source_file" ] && ln -sf "$source_file" . || { echo "Error while linking $source_file "; exit 1;}
        """

    [[move_outputs]]
        script = """
            echo "Move Outputs"
            mkdir -p $OUTPUT_DIR/ATM
            mv wrfout_* wrfprs_* $OUTPUT_DIR/ATM/

            mkdir -p $OUTPUT_DIR/OCN
            mv *.data *.meta  $OUTPUT_DIR/OCN/
        """

    [[prepare_mitgcm2nc4]]
        script = """
          mkdir -p $ARCHIVE_PATH/AUX/
          # Copy all grid data, this is not written in a restart run
          find -maxdepth 1 -name "??.??ta" -exec cp -t $ARCHIVE_PATH/AUX/ {} + #2
          find -maxdepth 1 -name "???.??ta" -exec cp -t $ARCHIVE_PATH/AUX/ {} + #3
          find -maxdepth 1 -name "?????.??ta" -exec cp -t $ARCHIVE_PATH/AUX/ {} + #5
          find -maxdepth 1 -name "??????.??ta" -exec cp -t $ARCHIVE_PATH/AUX/ {} + #6
          find -maxdepth 1 -name "???????.??ta" -exec cp -t $ARCHIVE_PATH/AUX/ {} + #7
          find -maxdepth 1 -name "????????.??ta" -exec cp -t $ARCHIVE_PATH/AUX/ {} + #8

          # Now remove the grid files
          rm -f ??.??ta #2
          rm -f ???.??ta #3
          rm -f ?????.??ta #5
          rm -f ??????.??ta #6
          rm -f ???????.??ta #7
          rm -f ????????.??ta #8

          #link it from archive path
          ln -s $ARCHIVE_PATH/AUX/??.??ta . #2
          ln -s $ARCHIVE_PATH/AUX/???.??ta . #3
          ln -s $ARCHIVE_PATH/AUX/?????.??ta . #5
          ln -s $ARCHIVE_PATH/AUX/??????.??ta . #6
        """

    [[mitgcm2nc4]]
        script = """
          $PYTHON mitgcm2nc4.py
        """
        platform=cluster
        [[[directives]]]
            --nodes = 1
            --ntasks=1
            --time=12:00:00

    [[scrap_rundir]]
        script = """
            echo "Scrap run directory"
            rm -rf *
        """


    [[skrips]]
        script = """
            
            [[ "$CYLC_TASK_CYCLE_POINT" == "$CYLC_WORKFLOW_INITIAL_CYCLE_POINT" ]] &&  export restart=".false."

            ln -sf ../wps_real/wrf* .
            ln -sf {{ BATHY_FILE }} .
            ln -sf {{ MITGRID_FILE }} . 
            cp -f {{ WRF_RUN_DIR }}/* .
            cp -f $etcdir/* .
            envsubst < $etcdir/namelist.esmf > namelist.esmf
            envsubst < $etcdir/namelist.wps > namelist.wps
            envsubst < $etcdir/namelist.input_40levs > namelist.input
            envsubst < $etcdir/data > data
            envsubst < $etcdir/data.cal > data.cal
            envsubst < $etcdir/namelist.rc > namelist.rc

            # Link Ocean BND and INI files
            ln -sf {{ GLORYS_DATA }}/* .
            source {{ ENV_FILE }}
            srun {{ SKRIPS_EXE }}
        """
        platform = cluster
        [[[directives]]]
            --nodes = {{ nNodes }}
            --ntasks = {{ cpuTotal }}
            --time=24:00:00

    [[upp]]
      script = """
       ln -fs ${txtCntrlFile} postxconfig-NT.txt
       ln -fs {{ UPP_DIR }}/parm/post_avblflds.xml post_avblflds.xml
       ln -fs {{ UPP_DIR }}/src/lib/g2tmpl/params_grib2_tbl_new params_grib2_tbl_new
       ln -fs {{ UPP_DIR }}/parm/nam_micro_lookup.dat .
       ln -fs {{ UPP_DIR }}/parm/hires_micro_lookup.dat .

       ln -fs $CRTMDIR/EmisCoeff/IR_Water/Big_Endian/* .

       ln -fs $CRTMDIR/EmisCoeff/IR_Land/SEcategory/Big_Endian/* .

       ln -fs $CRTMDIR/AerosolCoeff/Big_Endian/AerosolCoeff.bin     ./
       ln -fs $CRTMDIR/CloudCoeff/Big_Endian/CloudCoeff.bin         ./

       ln -fs $CRTMDIR/SpcCoeff/Big_Endian/* .
       ln -fs $CRTMDIR/TauCoeff/ODPS/Big_Endian/* .
       source {{ ENV_FILE }}
       module load upp/4.0.1/intel2021.2
       modelDataPath=$(pwd)
       current_date=${CYLC_TASK_CYCLE_POINT}
       while [[ $current_date < $NEXT_CYCLE_POINT ]]; do
            export dateStamp=$({{ ISODATETIME }} ${current_date} --format CCYY-MM-DDThh:mm:ss | sed 's/T/_/g')
            export inFile=${modelDataPath}/wrfout_d01_$dateStamp
            oFile=$modelDataPath/wrfprs_d01_${dateStamp}.grb2

            # Check if that file exists
            if [[ ! -e ${inFile} ]]; then
              echo "ERROR: Can't find ${inFile}. Directory or file does not exist.  Exiting..."
              echo "ERROR: Check if 'modelDataPath': ${modelDataPath} exists."
              exit 1
            fi
            #uppdir="upp/$dateStamp"
            #mkdir -p $uppdir && cd $uppdir
    
            envsubst < $etcdir/itag > itag
            #workdir=$(pwd)
            #cd -
            srun -n {{ cpuPerNode }} {{ UPP_DIR }}/bin/unipost.exe 
            mv WRFPRS*.${tmmark} $oFile
            current_date=$({{ ISODATETIME }} ${current_date} --offset1=PT{{ atmOutFreqMins }}M)
       done
      """
      platform = cluster
      [[[environment]]]
        txtCntrlFile=$CYLC_WORKFLOW_RUN_DIR/etc/postxconfig-NT-WRFPRS.txt # grib2
        tmmark=tm00
        #MP_SHARED_MEMORY=no
        #MP_LABELIO=yes
        CRTMDIR={{ UPP_DIR }}/src/lib/crtm2/src/fix

      [[[directives]]]
         --nodes = 1
         --ntasks = {{ cpuPerNode }}


